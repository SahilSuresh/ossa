{
  "name": "ossa",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@sentry/react-native": "^8.32.0",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.21",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-store-review": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.26",
    "expo-widgets": "~57.0.22",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-purchases": "^10.11.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "scripts": {
    "prestart": "node scripts/build-html.js",
    "start": "expo start --lan --go",
    "share": "node scripts/build-html.js && node scripts/share.js",
    "tunnel": "node scripts/build-html.js && expo start --tunnel --go",
    "dev": "node scripts/build-html.js && expo start --lan --dev-client",
    "build:android": "node scripts/build-html.js && npx eas-cli@latest build --profile preview --platform android",
    "build:ios": "node scripts/build-html.js && npx eas-cli@latest build --profile production --platform ios",
    "submit:ios": "npx eas-cli@latest submit --platform ios --latest",
    "lint:tokens": "node scripts/check-tokens.js",
    "preview": "node scripts/preview-server.js",
    "postinstall": "patch-package",
    "update": "echo Over-the-air updates are off since 23 Oct 2026 (App Review): ship every change in a new build. See docs/DECISIONS.md. && exit 1"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "patch-package": "^8.0.1"
  },
  "overrides": {
    "react-native-health": {
      "@expo/config-plugins": "57.0.9"
    }
  }
}
